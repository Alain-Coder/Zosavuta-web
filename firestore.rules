rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read for routes (bus routes) so anyone can browse
    match /routes/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Bus operators collection – only authenticated users can manage their own operator doc
    match /busOperators/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == docId; // assume docId matches user uid
    }
    // Buses – only operator can read/write their buses
    match /buses/{docId} {
      allow read, write: if request.auth != null &&
        exists(/databases/$(database)/documents/busOperators/$(request.auth.uid));
    }
    // Trips – only operator can manage their trips
    match /trips/{docId} {
      allow read, write: if request.auth != null &&
        exists(/databases/$(database)/documents/busOperators/$(request.auth.uid));
    }
    // Bookings – user can read/write their own bookings
    match /bookings/{docId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    // Tickets – only the owner of the booking can read the ticket
    match /tickets/{docId} {
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.userId == request.auth.uid;
      allow create: if request.auth != null &&
        get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.userId == request.auth.uid;
    }
  }
}
